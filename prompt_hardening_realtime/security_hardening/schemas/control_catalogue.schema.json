{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudsec/security_hardening/control_catalogue.schema.json",
  "title": "ControlCatalogue",
  "description": "Structure of catalogue/security_controls.yaml once loaded. Structural rules only; catalogue.py adds the semantic checks (fact names/values against models.FACT_VOCABULARY, regexes compile, ids unique, services inside config/scope.yaml, derived controls list their supporting references, active controls carry traceable provenance).",
  "type": "object",
  "required": [
    "catalogue_id",
    "catalogue_version",
    "schema_version",
    "updated_at",
    "freshness",
    "requirement_cues",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "catalogue_id": {
      "type": "string",
      "minLength": 1
    },
    "catalogue_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": "1"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "scope_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "last_sync_status"
      ],
      "additionalProperties": false,
      "properties": {
        "last_sync_attempt": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_sync_status": {
          "enum": [
            "never_synced",
            "ok",
            "failed"
          ]
        },
        "last_known_good_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "requirement_cues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object"
    },
    "supporting_reference": {
      "type": "object",
      "required": [
        "source_name",
        "source_url",
        "source_version_or_section"
      ],
      "additionalProperties": false,
      "properties": {
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^(https://|repo:)"
        },
        "source_version_or_section": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conflict_trigger": {
      "type": "object",
      "required": [
        "id",
        "when",
        "why",
        "alternative"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "unless": {
          "$ref": "#/$defs/condition"
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "alternative": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "enum": [
            "mandatory",
            "recommended"
          ]
        }
      }
    },
    "required_context": {
      "type": "object",
      "required": [
        "key",
        "question",
        "why_it_matters",
        "provided_when"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1
        },
        "provided_when": {
          "$ref": "#/$defs/condition"
        },
        "blocking": {
          "type": "boolean"
        },
        "default_assumption": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "control_id",
        "control_category",
        "control_name",
        "control_description",
        "enforcement",
        "applicability_conditions",
        "affected_services_or_components",
        "required_prompt_clause",
        "verification_expectation",
        "severity_or_priority",
        "source_name",
        "source_url",
        "source_version_or_section",
        "retrieved_at",
        "content_hash",
        "provenance_status",
        "derived",
        "supporting_references",
        "catalogue_version",
        "active_status"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,4}-[A-Z]{2,10}-[0-9]{3}$"
        },
        "control_category": {
          "enum": [
            "identity_and_permissions",
            "storage_and_cloud_resources",
            "network_exposure",
            "application_and_api",
            "database_and_sensitive_data",
            "development_and_observability"
          ]
        },
        "control_name": {
          "type": "string",
          "minLength": 3
        },
        "control_description": {
          "type": "string",
          "minLength": 20
        },
        "enforcement": {
          "enum": [
            "mandatory",
            "recommended"
          ]
        },
        "applicability_conditions": {
          "$ref": "#/$defs/condition"
        },
        "satisfied_by": {
          "$ref": "#/$defs/condition"
        },
        "affected_services_or_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_prompt_clause": {
          "type": "string",
          "minLength": 30,
          "maxLength": 520
        },
        "verification_expectation": {
          "type": "string",
          "minLength": 20,
          "maxLength": 420
        },
        "severity_or_priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^(https://|repo:)"
        },
        "source_version_or_section": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance_status": {
          "enum": [
            "unverified",
            "section_checked",
            "snapshot_verified"
          ]
        },
        "derived": {
          "type": "boolean"
        },
        "supporting_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supporting_reference"
          }
        },
        "source_status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "conflict_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict_trigger"
          }
        },
        "required_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/required_context"
          }
        },
        "catalogue_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "active_status": {
          "enum": [
            "active",
            "draft",
            "deprecated"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
