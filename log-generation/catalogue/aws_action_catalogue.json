  "security_constraint_triggers": {
    "require_encryption": {
      "target_service": "s3",
      "action_id": "act-s3-put-bucket-encryption",
      "rationale": "Enforce AES256 or KMS server-side encryption at rest"
    },
    "block_public_access": {
      "target_service": "s3",
      "action_id": "act-s3-put-public-access-block",
      "rationale": "Prevent unintended public access to S3 bucket assets"
    },
    "enable_versioning": {
      "target_service": "s3",
      "action_id": "act-s3-put-bucket-versioning",
      "rationale": "Maintain bucket object version history for ransomware protection"
    },
    "enable_key_rotation": {
      "target_service": "kms",
      "action_id": "act-kms-enable-key-rotation",
      "rationale": "Enforce automatic annual key rotation for compliance"
    }
  },
