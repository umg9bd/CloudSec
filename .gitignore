.venv

# Stratus Red Team collection - never commit credentials, and raw
# compressed CloudTrail exports are redundant with the organized JSON
# under stratus_own_runs/CloudTrail (which IS meant to be committed).
.aws/
**/stratus_collection/raw_s3/
*.pem
*_rsa
credentials.json
__pycache__/
*.pyc

# OS junk
.DS_Store

# ── Generated artefacts ─────────────────────────────────────────────────
# copy_assets() in prepare_lstm_dataset.py copies these out of
# datasets/privilege-escalation/. Two tracked copies of the same file can
# drift apart silently, and the copy is reproducible, so only the source is
# committed.
temporal-analysis/data/lstm/cloudtrail_temporal.csv
temporal-analysis/data/lstm/cloudtrail_structural.csv

# Watch-mode test batches -- ephemeral, produced by
# feature_engine9.py --simulate and regenerated on demand. The two
# synthetic_*.json fixtures in the same directory ARE committed on purpose.
incoming/cloudtrail_*.csv

# Build output
.dist/
