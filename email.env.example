# Email alerts (notify.py). Copy this file to email.env (git-ignored) and fill in the sender;
# run.cmd / run.sh pass it to the pipeline. The admin's address is entered on the dashboard
# (sidebar, "Email alerts"); CLOUDSEC_ADMIN_EMAIL is only used if nothing was saved there.
#
# The sender must be a Gmail account with 2-Step Verification on. Create an app password at
# Google Account -> Security -> 2-Step Verification -> App passwords, and paste its 16 characters
# below (spaces are fine). It is NOT the account's normal password.
CLOUDSEC_SMTP_USER=your.sender@gmail.com
CLOUDSEC_SMTP_PASSWORD=abcd efgh ijkl mnop
# CLOUDSEC_ADMIN_EMAIL=admin@example.com
# CLOUDSEC_EMAIL_MAX_PER_HOUR=60
